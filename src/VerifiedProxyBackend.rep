#include <QVariantMap>

// The QML-facing surface of verified_proxy_module.
//
// Deliberately small: this is a management panel — configure, start, stop,
// watch state, make a few calls — not a wallet.
class VerifiedProxyBackend
{
    // ── State, refreshed by polling ─────────────────────────────────────
    //
    // Polled rather than event-subscribed on purpose. A UI plugin's event
    // subscription is one-shot and is refused if it is armed before the
    // registry handshake, with no retry — so a panel built on subscriptions
    // silently shows nothing when it loses that race. status() is cheap and
    // never touches the proxy thread, so a 2s poll is both simpler and
    // strictly more robust here.
    PROP(QString state READONLY)          // uninitialized|configured|starting|running|degraded|stopping|stopped|error
    PROP(bool running READONLY)
    PROP(QString endpoint READONLY)       // the module's own JSON-RPC URL, "" when disabled
    PROP(QString statusJson READONLY)     // full status() payload, pretty-printed
    PROP(QString headBlock READONLY)
    PROP(int chainId READONLY)
    PROP(QString lastError READONLY)
    PROP(bool busy READONLY)              // a lifecycle call is in flight

    // The module's network table, as a JSON array of
    // {name, chainId, beaconApiUrl, executionApiUrl}. Fetched once at startup.
    // The view builds its network selector from THIS rather than a hardcoded
    // list: `network` is a value that reaches a quit() inside the Nim library
    // when upstream does not recognise it, so a list that drifts from the
    // module's whitelist would take the host process down.
    PROP(QString networksJson READONLY)

    // The config the MODULE has stored, fetched once at startup so the form
    // comes back as it was left. The module owns persistence: it writes the
    // config it accepts to its own instance directory and reloads it on load,
    // so a config applied from the CLI shows up here too.
    PROP(QString configJson READONLY)

    // The network the MODULE is actually configured for, which is not
    // necessarily the one selected in the form. They differ between changing
    // the selector and pressing Start, and the State panel below is describing
    // the module's, not the form's.
    PROP(QString configuredNetwork READONLY)
    PROP(QString uiVersion READONLY)

    // ── Lifecycle ───────────────────────────────────────────────────────
    // Applies `configJson` and then starts, as ONE operation.
    //
    // Deliberately not two slots a view calls in sequence: start() runs the
    // config the module has STORED, so a separate configure step that the
    // operator can skip means an edited form silently starts the previous
    // config. The module also refuses to reconfigure while running, so
    // "apply, then start" is the only ordering that is ever valid anyway.
    SLOT(void applyAndStart(QString configJson))
    SLOT(void stop())
    SLOT(void refreshStatus())

    // Asks the MODULE to fetch a finalized block root, because Basecamp
    // sandboxes ui_qml plugins away from the network: an XMLHttpRequest from
    // the view is refused outright ("sandboxed ui_qml modules may not use the
    // network"). A core module has no such restriction.
    SLOT(void fetchFinalizedRoot(QString beaconUrl))

    // ── Calls ───────────────────────────────────────────────────────────
    // `paramsJson` is a JSON array, matching the module's rpc(method, params).
    SLOT(void callRpc(QString method, QString paramsJson))

    // ── Signals ─────────────────────────────────────────────────────────
    SIGNAL(configured(bool ok, QString error))
    SIGNAL(startFinished(bool ok, QString error))
    SIGNAL(stopFinished(bool ok, QString error))
    SIGNAL(statusUpdated(QVariantMap status))
    SIGNAL(callFinished(QString method, bool ok, QString result))
    SIGNAL(logLine(QString line))
    SIGNAL(finalizedRootFetched(bool ok, QString root, QString error))
}
